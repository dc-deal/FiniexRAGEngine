# Copy to .env and fill in. .env is gitignored — never commit real keys.

# OpenAI API (platform.openai.com — pay-as-you-go, NOT the ChatGPT subscription)
OPENAI_API_KEY=sk-...

# PostgreSQL / pgvector connection (matches docker-compose defaults)
DATABASE_URL=postgresql://ragengine:ragengine@postgres:5432/ragengine

# API bearer token(s) for consumers, `name:token` — comma-separated for several (#98).
# Without one the server refuses to start: an unauthenticated engine must never be what a
# forgotten variable produces. Generate one with
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leaving this empty is fine if the tokens live in user_configs/app_config.json (api.tokens)
# instead — an empty variable does not shadow the overlay.
FINIEX_API_TOKENS=

# Bearer token for querying a LIVE engine over its public edge, from this machine — the CLIENT
# side, i.e. the token a caller presents. Empty here on purpose: a fresh clone has no live engine
# to query, and this is only useful once someone runs one and issues a token for themselves.
# Deliberately NOT named FINIEX_API_TOKENS: that is the server side, the set of tokens this engine
# accepts. The two are one character apart and mean opposite things.
FINIEX_LIVE_CLIENT_TOKEN=

{
    // FiniexRAGEngine — debug / run entry points
    "version": "0.2.0",
    "configurations": [
        // ====================================================
        // 🚀 SERVICE (run the engine)
        // ====================================================
        // All three pass --host 0.0.0.0: the container exception to ISSUE_98's loopback default.
        // Inside a container that default binds the CONTAINER's loopback, which leaves the compose
        // publish (127.0.0.1:8100:8100) without an upstream — Docker's forwarder accepts the
        // connection and closes it immediately, so host.docker.internal:8100 is dead for a consumer
        // container while the port still looks open. Exposure stays bounded by that publish, not by
        // the bind; the deployed engine keeps the loopback default because it is not launched here.
        {
            "name": "🚀 RAGEngine: API Server (reload)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/finiexragengine/cli/server_cli.py",
            "args": [
                "--host",
                "0.0.0.0",
                "--reload",
                "--port",
                "8100"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "presentation": {
                "group": "01_service",
                "order": 1
            }
        },
        {
            // Live mode (ISSUE_10): background ingest+eval workers on their own
            // cadences — continuous paid activity, run deliberately.
            "name": "💸 RAGEngine: API Server + Workers (live, paid)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/finiexragengine/cli/server_cli.py",
            "args": [
                "--host",
                "0.0.0.0",
                "--workers",
                "--port",
                "8100"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "presentation": {
                "group": "01_service",
                "order": 2
            }
        },
        {
            // + the live terminal dashboard (ISSUE_26): needs a TTY; console logs move to
            // the rotating file so rich.Live owns the terminal exclusively.
            "name": "🖥️💸 RAGEngine: API Server + Workers + Live Display (paid)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/finiexragengine/cli/server_cli.py",
            "args": [
                "--host",
                "0.0.0.0",
                "--workers",
                "--live",
                "--port",
                "8100"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "presentation": {
                "group": "01_service",
                "order": 3
            }
        },
        // ====================================================
        // ⚙️ STAGE CLIs (real OpenAI API cost — a single stage, run deliberately)
        // ====================================================
        {
            "name": "💸 RAGEngine: Run Pipeline (full envelope, paid)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/finiexragengine/cli/run_cli.py",
            "args": [
                "--pipeline",
                "${input:pipeline}"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "presentation": {
                "group": "03_stage_clis",
                "order": 1
            }
        },
        {
            "name": "💸 RAGEngine: Ingest (fetch→embed→upsert, paid)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/finiexragengine/cli/ingest_cli.py",
            "args": [
                "--source-set",
                "${input:source_set}"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "presentation": {
                "group": "03_stage_clis",
                "order": 2
            }
        },
        {
            "name": "💸 RAGEngine: Evaluate Symbol (signal + prompt, paid)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/finiexragengine/cli/eval_cli.py",
            "args": [
                "--pipeline",
                "${input:pipeline}",
                "--symbol",
                "${input:symbol}"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "presentation": {
                "group": "03_stage_clis",
                "order": 3
            }
        },
        {
            // Variant fan-out (ISSUE_42): a variant stream is an ordinary pipeline_id —
            // this entry just composes it (<pipeline>_<variant>) from two prompts.
            "name": "💸 RAGEngine: Evaluate Symbol @ variant (paid)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/finiexragengine/cli/eval_cli.py",
            "args": [
                "--pipeline",
                "${input:pipeline}_${input:variant}",
                "--symbol",
                "${input:symbol}"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "presentation": {
                "group": "03_stage_clis",
                "order": 4
            }
        },
        // ====================================================
        // 📊 DIAGNOSTICS (read-only DB reports — free on cached query vectors)
        // ====================================================
        {
            "name": "📊 RAGEngine: Corpus Coverage Report",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/finiexragengine/cli/coverage_cli.py",
            "args": [
                "--pipeline",
                "${input:pipeline}"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "presentation": {
                "group": "04_diagnostics",
                "order": 2
            }
        },
        {
            // "Is the floor discriminating for this query at all?" Per-query distance
            // distribution against the live window, the knee the corpus itself suggests, and the
            // archive's mechanical-HOLD share side by side. Read-only; query vectors come from
            // the cache, so a run costs nothing on a hit. Groundwork for ISSUE_55.
            "name": "📊 RAGEngine: Retrieval Floor Profile (is the cut discriminating?)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/finiexragengine/cli/floor_profile_cli.py",
            "args": [
                "--pipeline",
                "${input:pipeline}"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "presentation": {
                "group": "04_diagnostics",
                "order": 3
            }
        },
        {
            "name": "📊 RAGEngine: Cost Report (real spend + projection)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/finiexragengine/cli/cost_cli.py",
            "args": [],
            "console": "integratedTerminal",
            "justMyCode": false,
            "presentation": {
                "group": "04_diagnostics",
                "order": 4
            }
        },
        {
            "name": "📊 RAGEngine: Performance Report",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/finiexragengine/cli/perf_cli.py",
            "args": [
                "--since",
                "7d"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "presentation": {
                "group": "04_diagnostics",
                "order": 5
            }
        },
        {
            "name": "📊 RAGEngine: Breaking Report (reaction + funnel)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/finiexragengine/cli/breaking_cli.py",
            "args": [
                "--since",
                "7d"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "presentation": {
                "group": "04_diagnostics",
                "order": 6
            }
        },
        {
            // "Do I believe that episode count?" The per-pass on/off series behind it: verdict
            // flips (the model's noise, unchanged by any grouping rule) next to episodes (what
            // the hysteresis rule made of them). Add a symbol for one series: --symbol XRPUSD.
            "name": "📊 RAGEngine: Breaking Timeline (flips vs episodes)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/finiexragengine/cli/breaking_timeline_cli.py",
            "args": [
                "--since",
                "7d"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "presentation": {
                "group": "04_diagnostics",
                "order": 7
            }
        },
        {
            "name": "📊 RAGEngine: Model Check (ingest + llm stage vs available)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/finiexragengine/cli/models_cli.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "presentation": {
                "group": "04_diagnostics",
                "order": 8
            }
        },
        {
            // Health (lifetime counters, flags/quarantine, problems) + the poll journal's
            // latency and outage sections. --since scopes only the journal window.
            "name": "📊 RAGEngine: Source Report (health + latency + outages)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/finiexragengine/cli/sources_cli.py",
            "args": [
                "--since",
                "7d"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "presentation": {
                "group": "04_diagnostics",
                "order": 9
            }
        },
        {
            // "This feed keeps dropping out — was our reaction proportionate?" One feed's
            // quarantine episodes with the ladder rung each reached, and the polls the policy
            // cost kept apart from the polls an outage cost. Use quarantine_episode_cli for the
            // poll-by-poll run-up to a single decision.
            "name": "📊 RAGEngine: Source History (quarantine episodes)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/finiexragengine/cli/source_quarantine_cli.py",
            "args": [
                "ecb_press",
                "--since",
                "30d"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "presentation": {
                "group": "04_diagnostics",
                "order": 10
            }
        },
        {
            // "Is a feed worth the weight it was given?" Articles produced against articles that
            // actually reached a prompt, per feed, next to the hand-set source_weight — the
            // observation that scale has never been checked against (ISSUE_82 finding 9).
            // Omit the source-set id to render every set.
            "name": "📊 RAGEngine: Source Contribution (what each feed delivered)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/finiexragengine/cli/source_contribution_cli.py",
            "args": [
                "${input:source_set}",
                "--since",
                "7d"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "presentation": {
                "group": "04_diagnostics",
                "order": 11
            }
        },
        {
            // Touches the feeds' network (no LLM/embeddings — no spend); resolves URLs from
            // the source-set configs. Omit --source to probe all feeds.
            "name": "📊 RAGEngine: Feed Doctor (raw output + parse diagnosis)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/finiexragengine/cli/feed_doctor_cli.py",
            "args": [],
            "console": "integratedTerminal",
            "justMyCode": false,
            "presentation": {
                "group": "04_diagnostics",
                "order": 12
            }
        },
        {
            // "Did the last prompt bump move the scores?" The urgency distribution per prompt
            // version, per pipeline — with the confirm band's concentration next to its share,
            // because forex v3 read healthy at 10.78% while ONE symbol supplied 93% of it.
            // Never pooled: the v3→v4 aggregate moved 6.67%→6.60% while both streams were rebuilt.
            "name": "📊 RAGEngine: Prompt Drift (score distribution per version)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/finiexragengine/cli/prompt_drift_cli.py",
            "args": [
                "--since",
                "30d"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "presentation": {
                "group": "04_diagnostics",
                "order": 13
            }
        },
        // ====================================================
        // Weekly
        // ====================================================
        {
            "name": "📊 RAGEngine: Weekly Report (console)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/finiexragengine/cli/report_cli.py",
            "args": [],
            "console": "integratedTerminal",
            "justMyCode": false,
            "presentation": {
                "group": "05_weekly",
                "order": 0
            }
        },
        {
            "name": "📨 RAGEngine: Weekly Report → Telegram (--send)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/finiexragengine/cli/report_cli.py",
            "args": [
                "--send"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "presentation": {
                "group": "05_weekly",
                "order": 1
            }
        },
        // ====================================================
        // output
        // ====================================================      
        {
            // The regular handgriff: only days that closed since the last export (reads the
            // archive_export_log DB flag). Idempotent, no re-writing the whole history. Same
            // mode the weekly report uses. No API cost.
            "name": "📦 RAGEngine: Export Outcomes — incremental (new closed days)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/finiexragengine/cli/export_cli.py",
            "args": [
                "--out",
                "data/signal_export",
                "--incremental"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "presentation": {
                "group": "06_output",
                "order": 0
            }
        },
        {
            // Whole closed days of the current ISO week (Mon 00:00 UTC onward), regardless of the
            // flag — but flags what it writes. Handy for re-cutting this week for a handover.
            "name": "📦 RAGEngine: Export Outcomes — since this week",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/finiexragengine/cli/export_cli.py",
            "args": [
                "--out",
                "data/signal_export",
                "--since",
                "week"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "presentation": {
                "group": "06_output",
                "order": 1
            }
        },
        {
            // Deliberate full re-export: every closed day, all-time (ignores the flag, flags all).
            // Explicit --all so a full rebuild is never accidental.
            "name": "📦 RAGEngine: Export Outcomes — ALL (all-time, deliberate)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/finiexragengine/cli/export_cli.py",
            "args": [
                "--out",
                "data/signal_export",
                "--all"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "presentation": {
                "group": "06_output",
                "order": 2
            }
        },
        {
            // One bucket: the day a YYYY-MM-DD falls into (prompted). Ignores the flag, flags it.
            "name": "📦 RAGEngine: Export Outcomes — single day",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/finiexragengine/cli/export_cli.py",
            "args": [
                "--out",
                "data/signal_export",
                "--day",
                "${input:day}"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "presentation": {
                "group": "06_output",
                "order": 3
            }
        },
        {
            // 🧪 SYNTHETIC — this writes MOCK envelopes, not engine output. It sits in this group
            // because it produces the same archive shape for the same consumer (the Testing IDE),
            // which is exactly why the distinction has to be loud: never point --out at
            // `data/signal_export`, and keep the `_mock` suffix on --pipeline-id so a generated
            // stream can never land in a real stream's directory.
            // One forex week: 1008 cycles x 10min = 7 days, rotated into one file per UTC day.
            // No database, no API — pure local file writing, so it costs nothing and needs nothing.
            "name": "🧪 Mock Data: Forex week (synthetic — NOT engine output)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/experiments/mock_signal_data/generate.py",
            "args": [
                "--cycles",
                "1008",
                "--start",
                "2026-04-27T00:00:00Z",
                "--rotate",
                "daily",
                "--prompt",
                "forex",
                "--pipeline-id",
                "forex_macro_sentiment_mock",
                // Mirrors the SYMBOL SET of configs/pipelines/forex_macro_sentiment.json, and has
                // to keep mirroring it: the symbol COUNT drives the generator's rng draws, so a
                // shortened list is not a smaller fixture but a different realization — every
                // signal, score and pass timing changes. A consumer holding an earlier week cannot
                // merge the two. Check this list against the pipeline config before regenerating.
                "--symbols",
                "EURUSD,GBPUSD,USDJPY,AUDUSD,EURGBP,NZDUSD,USDCAD,USDCHF",
                // `--rotate` writes <out>/<stream_id>/<bucket>.jsonl, so pointing --out at `data`
                // puts the stream directory at the root: data/forex_macro_sentiment_mock/<day>.jsonl
                // — the handover shape. Everything NOT in this layout (single-file runs, variant
                // fan-outs) stays under data/mock_signals/ beside it.
                "--out",
                "data"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "presentation": {
                "group": "06_output",
                "order": 4
            }
        },
        // ====================================================
        // 🗄 DATABASE MANAGEMENT (the schema itself — ISSUE_14)
        // ====================================================
        {
            // Read-only: what has been applied, what is waiting, what drifted.
            // Never changes the schema, so it is always safe to run.
            "name": "🗄 RAGEngine: Migration Status (read-only)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/finiexragengine/cli/migrate_cli.py",
            "args": [
                "--status"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "presentation": {
                "group": "07_database",
                "order": 1
            }
        },
        {
            // The ONLY writer of the schema: applies migrations/ in order, each in its own
            // transaction. Re-running is a no-op, so it is safe before every start — and the
            // engine refuses to boot while a migration is pending.
            // No API cost; it touches the database, not OpenAI.
            "name": "🗄 RAGEngine: Apply Migrations",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/finiexragengine/cli/migrate_cli.py",
            "args": [],
            "console": "integratedTerminal",
            "justMyCode": false,
            "presentation": {
                "group": "07_database",
                "order": 2
            }
        },
        // ====================================================
        // 🧩 TESTS (free — no API cost)
        // ====================================================
        {
            "name": "🧩 Pytest: All (free)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "tests/",
                "-v"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "presentation": {
                "group": "02_tests",
                "order": 1
            }
        },
        {
            "name": "🧩💸 Pytest: Live RAG (OpenAI, paid)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "tests/rag/test_rag_live.py",
                "-m",
                "paid",
                "-v"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "presentation": {
                "group": "02_tests",
                "order": 2
            }
        },
    ],
    // Prompted at launch so the CLI entries can target any constellation.
    "inputs": [
        {
            "id": "pipeline",
            "type": "promptString",
            "description": "Pipeline id (configs/pipelines/<id>.json)",
            "default": "crypto_sentiment"
        },
        {
            "id": "symbol",
            "type": "promptString",
            "description": "Symbol to evaluate (e.g. BTCUSD)",
            "default": "BTCUSD"
        },
        {
            "id": "variant",
            "type": "promptString",
            "description": "Variant sub_pipeline_id — stream = <pipeline>_<variant> (ISSUE_42)",
            "default": "4o_enhanced"
        },
        {
            "id": "source_set",
            "type": "promptString",
            "description": "Source-set id (configs/source_sets/<id>.json)",
            "default": "crypto_news"
        },
        {
            "id": "day",
            "type": "promptString",
            "description": "Export the bucket this UTC day falls into (YYYY-MM-DD)",
            "default": "2026-07-21"
        }
    ]
}
# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Secrets — never commit
.env
*.key

# Runtime data / logs
data/
logs/

# CLAUDE.md is published (the engineering rulebook — workflow transparency).
# Internal working docs stay private — never published.
INTERNAL_*.md
ISSUE_*.md
HANDOFF_*.md
# Cross-repo handover notes (e.g. to the Testing IDE) — operator transfer artifact
IMPORT_NOTES_*.md

# Local issue snapshot utility + its output (personal, never published)
export_github_issues.sh
github_issues/

# Operator/secret config overrides (account credit, telegram token, …) — deep-merged
# onto configs/app_config.json at load; never committed.
#
# The CONTENTS are ignored rather than the directory, because git cannot re-include a file whose
# parent directory is excluded — and one file has to be tracked: the template below. It is the only
# thing a fresh clone can see of this layer, which is otherwise invisible to it.
user_configs/*
!user_configs/app_config.example.json

# MCP server registration — points at /bus, which only a machine with the bus folder has.
# A tracked copy would hand every clone a server pointing at a path that does not exist.
# .mcp.json.example is the tracked counterpart, like .env.example and user_configs/.
.mcp.json

# Local dev-home seed (personal state, restored after container rebuilds)
.devcontainer/local/

# OS / editor
.DS_Store
